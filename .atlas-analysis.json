  "keyFeatures": [
    "Virtual Machine Management - Control VMs with start/stop/restart actions via Discord",
    "Advanced Ticket System - Professional support system with HTML transcripts and compression",
    "Announcement Distribution - Modular system for broadcasting updates across channels",
    "Modular Architecture - Automatic loading of commands, events, and components",
    "Database Integration - Prisma ORM with MariaDB for robust data management",
    "Real-time VM Monitoring - Track VM status and send alerts to users",
    "Multi-language Support - Built-in translation system for internationalization"
  ],
  "publicApiSurface": [
    "/vm list - List all available virtual machines",
    "/vm status - Check VM status",
    "/vm action - Execute actions (start/stop/restart/pause/resume/reset)",
    "/vm monitor start - Start monitoring a VM for a user",
    "/vm monitor stop - Stop monitoring a VM",
    "/vm panel list - List all virtualization panels",
    "/vm panel new - Create a new virtualization panel",
    "/tickets new - Create a new ticket",
    "/tickets close - Close a ticket",
    "/tickets setup - Setup ticket system in a channel",
    "/tickets config transcript - Configure transcript channel",
    "/tickets config opinions - Configure opinions channel",
    "/tickets category new - Create a ticket category",
    "/tickets user add - Add user to ticket",
    "/announce - Create and distribute announcements",
    "/ping - Check bot latency",
    "/sync - Sync commands with Discord",
    "ExtendedClient - Main bot client with modular loaders",
    "VirtualizationManager - Manage VM panels and operations",
    "VirtualizationMonitor - Monitor VM status changes",
    "Tickets - Ticket system management",
    "CommandsLoader - Automatic command loading system",
    "EventsLoader - Automatic event loading system",
    "ComponentsLoader - Automatic component loading system"
  ]
}
